# Copy into Vercel > Project > Settings > Environment Variables (and .env.local for local dev).

# The SAME three values DispatchLens uses (DispatchLens's Vercel project > Settings > Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud > IAM > Service accounts > your robot account > Keys (JSON). Paste these two fields.
GOOGLE_SERVICE_ACCOUNT_EMAIL=deallens-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Honey Touch Master Database
SHEET_ID=11UPpzvWyFdMYOasRFevpS4-rP6e8a0pOWKdW1g5vTwU
SHEET_RANGE=Sheet1

# A NEW Scrapingdog key (the old one is visible in ListingLens's public code)
SCRAPINGDOG_API_KEY=

# Any long random string. Vercel sends it to the scheduled jobs.
CRON_SECRET=
